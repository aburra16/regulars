# Optional, development only. Relays to read reviews from (comma-separated); without them the app
# reads no reviews. `npm run proof:house-scores` with PROOF_KEEP=1 prints both lines for a local relay.
# VITE_REVIEW_RELAYS=ws://localhost:10547
# VITE_DEV_SCORER=<scorer's public key in hex>@ws://localhost:10547

# Optional, development only. Relays to read and save follow lists at (comma-separated), beside a
# person's own; without them a development build keeps follow lists on no relay of the app's, so
# Follow says it couldn't load. Never the public relays: use a relay on this machine.
# Whatever is set here, a development build signed in with a real key reads that key's relay list
# from purplepag.es and saves a tapped follow to that person's own public relays: sign in with a
# throwaway key in development.
# VITE_FOLLOW_LIST_RELAYS=ws://localhost:10547

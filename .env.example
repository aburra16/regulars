# Optional. MapTiler API key for the map; without it the app runs with no map.
VITE_MAPTILER_KEY=

# Optional, development only. Relays to read reviews from (comma-separated); without them the app
# reads no reviews. `npm run proof:house-scores` with PROOF_KEEP=1 prints both lines for a local relay.
# VITE_REVIEW_RELAYS=ws://localhost:10547
# VITE_DEV_SCORER=<scorer's public key in hex>@ws://localhost:10547
